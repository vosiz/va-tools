{
    "name": "vosiz/va-tools",
    "description": "PHP tools (from Variable Arts)",
    "type": "library",
    "license": "MIT",
    "keywords": ["php", "tools", "database", "pdo", "query-builder", "xml", "html", "filter", "debug"],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Vosiz\\VaTools\\": "src/"
        },
        "files": [
            "src/db/dbcon.php",
            "src/filter/strfilter.php",
            "src/parser/url.php",
            "src/struct/cred.php",
            "src/struct/flag.php",
            "src/struct/nodeh.php",
            "src/format/xml/xml.php",
            "src/format/html/html.php",
            "src/shorty.php"
        ]
    },
    "require": {
        "php": ">=7.4",
        "vosiz/php-utils": "~1.12.0",
        "vosiz/php-enum": "~2.4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    }
}
